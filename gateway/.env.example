# Must match every other service
JWT_SECRET="replace-this-with-the-SAME-secret-configured-on-the-Auth-service"

# Local defaults
PORT=3000
CORS_ORIGIN="http://localhost:5173"
REDIS_URL="redis://localhost:6379"

# Downstream REST bases (used for routes that pass straight through to a
# service's own already-complete REST API)
AUTH_URL="http://localhost:3001"
CATALOG_URL="http://localhost:3002"
PAYMENT_URL="http://localhost:3004"

# Downstream gRPC targets (used for the routes that actually demonstrate
# REST -> gRPC translation: checkout, and a payment-by-order lookup)
ORDER_GRPC_URL="localhost:50053"
PAYMENT_GRPC_URL="localhost:50054"

# Rate limiting (Redis-backed, shared across every gateway replica)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Observability (OpenTelemetry)
OTEL_SERVICE_NAME="micromart-gateway"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_METRICS_PORT=9460
