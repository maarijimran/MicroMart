# Required: private order_db owned only by this service
DATABASE_URL="postgresql://micromart:micromart@localhost:5432/order_db?schema=public"
# Must match the Auth service, for local REST authentication
JWT_SECRET="replace-this-with-the-SAME-secret-configured-on-the-Auth-service"

# Local defaults
PORT=3003
GRPC_URL="0.0.0.0:50053"
CATALOG_GRPC_URL="localhost:50052"
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
IDEMPOTENCY_TTL_SECONDS=86400
