# Required
DATABASE_URL=""
JWT_SECRET="replace-this-with-the-SAME-secret-configured-on-the-Auth-service"

# Local defaults
REDIS_URL="redis://localhost:6379"
PORT=3002
GRPC_URL="0.0.0.0:50052"
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
ELASTICSEARCH_URL="http://localhost:9200"
PRODUCT_CACHE_TTL_SECONDS=60

# Product image storage (any S3-compatible service).
# Local: SeaweedFS from infra/docker-compose.yml. Production: point these at
# AWS S3 / R2 / etc. — leave S3_ENDPOINT empty for AWS, set S3_FORCE_PATH_STYLE=false,
# S3_AUTO_CREATE_BUCKET=false, and S3_PUBLIC_URL to the bucket or CDN URL.
S3_ENDPOINT="http://localhost:8333"
S3_REGION="us-east-1"
S3_BUCKET="micromart-products"
S3_ACCESS_KEY_ID="micromart"
S3_SECRET_ACCESS_KEY="micromart-local-secret"
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
S3_PUBLIC_URL="http://localhost:8333/micromart-products"
