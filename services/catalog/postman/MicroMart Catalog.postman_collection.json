{
  "info": {
    "name": "MicroMart Catalog",
    "description": "Local smoke tests for the MicroMart Catalog service. Run 'Login (Auth service)' first, or paste an admin accessToken into the adminAccessToken collection variable, to exercise the admin-only requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3002" },
    { "key": "authBaseUrl", "value": "http://localhost:3001" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "productId", "value": "" }
  ],
  "item": [
    {
      "name": "Login (Auth service)",
      "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('adminAccessToken', body.accessToken);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"StrongPass1!\"\n}" },
        "url": "{{authBaseUrl}}/auth/login"
      },
      "description": "Requires an admin account to already exist in the Auth service with role=admin (the DB only sets role=customer on self-registration; promote a user to admin directly in Postgres for local testing)."
    },
    {
      "name": "Create category (admin)",
      "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('categoryId', body.id);"] } }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Widgets\",\n  \"slug\": \"widgets\"\n}" },
        "url": "{{baseUrl}}/categories"
      }
    },
    {
      "name": "List categories",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/categories" }
    },
    {
      "name": "Create product (admin)",
      "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('productId', body.id);"] } }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"sku\": \"WID-001\",\n  \"name\": \"Chrome Widget\",\n  \"slug\": \"chrome-widget\",\n  \"description\": \"A shiny widget.\",\n  \"price\": 19.99,\n  \"initialQuantity\": 50\n}" },
        "url": "{{baseUrl}}/products"
      }
    },
    {
      "name": "Update product (admin)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"price\": 17.99\n}" },
        "url": "{{baseUrl}}/products/{{productId}}"
      }
    },
    {
      "name": "Set stock (admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"quantityAvailable\": 75\n}" },
        "url": "{{baseUrl}}/products/{{productId}}/stock"
      }
    },
    {
      "name": "Search products (public)",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/products?q=widget&page=1&pageSize=20" }
    },
    {
      "name": "Get product by id (public)",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/products/{{productId}}" }
    }
  ]
}
