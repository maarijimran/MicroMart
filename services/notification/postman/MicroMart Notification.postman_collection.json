{
  "info": {
    "name": "MicroMart Notification",
    "description": "This service has no functional REST API — it only consumes RabbitMQ events. The one request here is an admin-only introspection route to confirm notifications were logged after a checkout completes or cancels.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3005" },
    { "key": "authBaseUrl", "value": "http://localhost:3001" },
    { "key": "adminAccessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Login as admin (Auth service)",
      "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('adminAccessToken', body.accessToken);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"StrongPass1!\"\n}" },
        "url": "{{authBaseUrl}}/auth/login"
      }
    },
    {
      "name": "List logged notifications (admin)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }],
        "url": "{{baseUrl}}/notifications?page=1&pageSize=20"
      }
    }
  ]
}
