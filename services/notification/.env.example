# Required: private notification_db owned only by this service
DATABASE_URL="postgresql://micromart:micromart@localhost:5432/notification_db?schema=public"
# Must match the Auth service, for the (admin-only) local introspection endpoint
JWT_SECRET="replace-this-with-the-SAME-secret-configured-on-the-Auth-service"

# Local defaults
PORT=3005
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
IDEMPOTENCY_TTL_SECONDS=86400

# Observability (OpenTelemetry)
OTEL_SERVICE_NAME="micromart-notification"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_METRICS_PORT=9465
