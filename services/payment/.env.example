# Required: private payment_db owned only by this service
DATABASE_URL="postgresql://micromart:micromart@localhost:5432/payment_db?schema=public"
# Must match the Auth service, for local REST authentication
JWT_SECRET="replace-this-with-the-SAME-secret-configured-on-the-Auth-service"

# Local defaults
PORT=3004
GRPC_URL="0.0.0.0:50054"
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
IDEMPOTENCY_TTL_SECONDS=86400
# Set below 1 (e.g. 0.2 for a 20% failure rate) to exercise the payment.failed /
# compensation path on demand even with a fully-funded wallet. 1 = never randomly fail.
RANDOM_SUCCESS_RATE=1
